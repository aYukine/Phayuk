# Copy to deploy/deploy.env (git-ignored) and fill in.
DEPLOY_HOST=203.0.113.10      # VPS IP or hostname
DEPLOY_USER=root              # a non-root user works too (needs sudo)
DOMAIN=phayuk.com             # www.<domain> is included automatically
SITE_NAME=phayuk              # name of the nginx site file
REMOTE_ROOT=/var/www/phayuk   # releases are kept under here
# SSH_PORT=22
# CERTBOT_EMAIL=you@example.com
