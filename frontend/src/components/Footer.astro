---
import { site } from '../lib/content';
const year = new Date().getFullYear();
---

<footer class="mt-6 px-3 pb-3 sm:px-4 sm:pb-4">
  <div class="relative overflow-hidden rounded-[1.75rem] sm:rounded-[2.5rem] bg-primary text-white">
    <div class="blob -top-24 -right-24 h-72 w-72 bg-highlight/20"></div>
    <div class="container-x relative grid gap-10 py-14 md:grid-cols-12 md:gap-12 md:py-20">
      <div class="md:col-span-7">
        <p class="pill bg-white/10 text-white">Say hello 👋</p>
        <h2 class="mt-6 text-[2.1rem] leading-[1.1] sm:text-5xl font-semibold tracking-tight md:text-6xl">Let's build something<br /><span class="text-gold">real</span> together.</h2>
        {site.email && (
          <a href={`mailto:${site.email}`} class="btn mt-8 max-w-full break-all bg-white text-primary hover:bg-soft">✉ {site.email}</a>
        )}
      </div>

      <div class="flex flex-col justify-between gap-8 md:col-span-5">
        <div class="flex items-center gap-4 rounded-3xl bg-white/10 p-5 ring-1 ring-white/10">
          {site.avatar && <img src={site.avatar} alt={site.name} width="72" height="72" loading="lazy" class="h-18 w-18 rounded-2xl object-cover" />}
          <div>
            <p class="font-serif text-lg font-semibold">{site.name}</p>
            <p class="text-sm text-white/70">{site.role}</p>
            {site.location && <p class="mt-1 text-xs text-white/60">📍 {site.location}</p>}
          </div>
        </div>
        <ul class="flex flex-wrap gap-2 text-sm font-medium">
          {(site.socials || []).map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener me" class="inline-block rounded-full bg-white/10 px-4 py-2 hover:bg-white/20">{s.label} ↗</a></li>
          ))}
          {site.resume && <li><a href={site.resume} target="_blank" rel="noopener" class="inline-block rounded-full bg-white/10 px-4 py-2 hover:bg-white/20">Résumé ↓</a></li>}
        </ul>
      </div>
    </div>
    <div class="relative rounded-t-[50%_2.5rem] bg-white/[0.06] pt-10 sm:rounded-t-[50%_4rem] sm:pt-12">
      <div class="container-x flex flex-col justify-between gap-2 pb-6 text-xs text-white/60 sm:flex-row">
        <p class="font-medium">© {year} {site.name}. All rights reserved.</p>
        {site.footerBlurb && <p class="max-w-md sm:text-right">{site.footerBlurb}</p>}
      </div>
    </div>
  </div>
</footer>
