---
import { site } from '../lib/content';
const year = new Date().getFullYear();
---

<footer class="bg-black text-white">
  <div class="container-x grid gap-12 py-20 md:grid-cols-12">
    <div class="md:col-span-7">
      <p class="eyebrow text-neutral-500">Get in touch</p>
      <h2 class="mt-4 text-4xl font-black tracking-tight md:text-6xl">Let's build<br />something real.</h2>
      {site.email && (
        <a href={`mailto:${site.email}`} class="mt-8 inline-block border-b border-white/40 pb-1 text-lg font-medium hover:border-white md:text-xl">
          {site.email}
        </a>
      )}
    </div>

    <div class="flex flex-col justify-between gap-10 md:col-span-5">
      <div class="flex items-center gap-5 border border-white/10 p-5">
        {site.avatar && <img src={site.avatar} alt={site.name} width="72" height="72" loading="lazy" class="h-18 w-18 object-cover" />}
        <div>
          <p class="font-bold">{site.name}</p>
          <p class="mt-0.5 text-sm text-neutral-400">{site.role}</p>
          {site.location && <p class="eyebrow mt-2 text-neutral-500">{site.location}</p>}
        </div>
      </div>
      <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
        {(site.socials || []).map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener me" class="text-neutral-400 hover:text-white">{s.label} ↗</a></li>
        ))}
        {site.resume && <li><a href={site.resume} target="_blank" rel="noopener" class="text-neutral-400 hover:text-white">Résumé ↓</a></li>}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col justify-between gap-2 py-6 text-xs text-neutral-500 sm:flex-row">
      <p>© {year} {site.name}. All rights reserved.</p>
      {site.footerBlurb && <p class="max-w-md sm:text-right">{site.footerBlurb}</p>}
    </div>
  </div>
</footer>
