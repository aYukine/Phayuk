---
import { isExternal, type Link } from '../lib/content';
interface Props { links?: Link[] }
const { links = [] } = Astro.props;
const buttons = links.filter((l) => l.url && (l.display ?? 'button') !== 'embed');
---

{buttons.length > 0 && (
  <div class="flex flex-wrap gap-3">
    {buttons.map((l, i) => {
      const primary = (l.style ?? (i === 0 ? 'primary' : 'secondary')) === 'primary';
      return (
        <a href={l.url} class={primary ? 'btn-primary' : 'btn-secondary'} {...(isExternal(l.url) ? { target: '_blank', rel: 'noopener' } : {})}>
          {l.label || 'Open link'} <span aria-hidden="true">↗</span>
        </a>
      );
    })}
  </div>
)}
