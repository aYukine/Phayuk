---
import { site } from '../lib/content';
const path = Astro.url.pathname;
const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/awards/', label: 'Awards' },
  { href: '/blogs/', label: 'Journal' },
];
const isActive = (href: string) => path.startsWith(href);
---

<header id="site-header" class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur-md">
  <nav class="container-x flex h-16 items-center justify-between gap-6" aria-label="Main">
    <a href="/" class="flex shrink-0 items-center gap-2.5 font-serif text-lg font-bold tracking-tight" aria-label={`${site.brand} home`}>
      <img src="/favicon.ico" alt="" width="32" height="32" class="pixel h-8 w-8 rounded-md" />
      <span>{site.brand}</span>
    </a>

    <!-- Desktop -->
    <div class="hidden items-center gap-8 md:flex">
      <ul class="flex items-center gap-8 text-sm font-medium">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={isActive(l.href) ? 'page' : undefined}
                class:list={[
                  'relative py-5 transition-colors hover:text-ink',
                  isActive(l.href) ? 'text-ink after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:rounded-full after:bg-primary-strong' : 'text-muted',
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      {site.resume && <a href={site.resume} target="_blank" rel="noopener" class="btn-primary px-5 py-2.5">Résumé</a>}
    </div>

    <!-- Mobile toggle -->
    <button
      id="nav-toggle"
      type="button"
      class="-mr-2 flex h-11 w-11 items-center justify-center rounded-lg text-ink hover:bg-soft md:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <svg class="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      <svg class="icon-close hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-line bg-paper md:hidden">
    <ul class="container-x flex flex-col py-3">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class:list={['flex items-center justify-between rounded-lg px-3 py-3.5 text-base font-medium', isActive(l.href) ? 'bg-soft text-ink' : 'text-ink/80 hover:bg-soft']}
            >
              {l.label}<span class="text-muted" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
      {site.resume && (
        <li class="px-3 pt-3 pb-2">
          <a href={site.resume} target="_blank" rel="noopener" class="btn-primary w-full">Download résumé</a>
        </li>
      )}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
      toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
    };
    toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
    document.addEventListener('click', (e) => {
      if (!document.getElementById('site-header')?.contains(e.target as Node)) setOpen(false);
    });
    window.matchMedia('(min-width: 768px)').addEventListener('change', () => setOpen(false));
  }
</script>
