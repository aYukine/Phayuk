---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: string;
  back?: { href: string; label: string };
}
const { eyebrow, title, lead, image, back } = Astro.props;
---

<section class="relative overflow-hidden px-3 pt-4 sm:px-4">
  <div class="relative overflow-hidden rounded-[1.75rem] sm:rounded-[2.5rem] bg-soft">
    <div class="blob -top-20 -left-20 h-80 w-80 bg-highlight/70"></div>
    <div class="blob -top-24 -right-10 h-72 w-72 bg-gold/35"></div>
    <div class="blob -bottom-40 left-1/3 h-64 w-[36rem] bg-highlight/40"></div>
    <div class:list={['container-x relative grid items-center gap-10 py-10 md:py-20', image && 'lg:grid-cols-12']}>
      <div class={image ? 'lg:col-span-7' : ''}>
        {back && <a href={back.href} class="text-sm font-medium text-muted hover:text-ink">← {back.label}</a>}
        {eyebrow && <p class="mt-5"><span class="pill bg-paper">{eyebrow}</span></p>}
        <h1 class="reveal mt-5 max-w-4xl text-[2.5rem] leading-[1.05] sm:text-5xl font-semibold tracking-tight md:text-6xl">{title}</h1>
        {lead && <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-muted">{lead}</p>}
        <slot />
      </div>
      {image && (
        <div class="reveal lg:col-span-5">
          <div class="aspect-[4/3] overflow-hidden rounded-3xl border-4 border-paper shadow-lift sm:border-8 lg:rotate-2 lg:rounded-[2rem]">
            <img src={image} alt="" aria-hidden="true" class="h-full w-full object-cover" fetchpriority="high" />
          </div>
        </div>
      )}
    </div>
  </div>
</section>
