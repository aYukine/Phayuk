---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: string;
  back?: { href: string; label: string };
}
const { eyebrow, title, lead, image, back } = Astro.props;
---

<section class="relative overflow-hidden bg-black text-white">
  {image && (
    <img src={image} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
  )}
  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/40"></div>
  <div class="container-x relative pt-36 pb-16 md:pt-44 md:pb-20">
    {back && <a href={back.href} class="eyebrow text-neutral-400 hover:text-white">← {back.label}</a>}
    {eyebrow && <p class="eyebrow mt-6 text-neutral-400">{eyebrow}</p>}
    <h1 class="reveal mt-3 max-w-4xl text-4xl font-black tracking-tight md:text-6xl lg:text-7xl">{title}</h1>
    {lead && <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-neutral-300">{lead}</p>}
    <slot />
  </div>
</section>
