---
import type { Project } from '../lib/content';
interface Props { project: Project; index: number; large?: boolean }
const { project, index, large = false } = Astro.props;
const cover = project.cover || project.steps?.[0]?.img;
const tints = ['bg-soft', 'bg-leaf', 'bg-lime', 'bg-sunny', 'bg-cloud'];
---

<a href={`/projects/${project.id}/`} class="card card-hover group block h-full p-3">
  <div class:list={['relative overflow-hidden rounded-2xl', tints[index % tints.length], large ? 'aspect-[16/9]' : 'aspect-[4/3]']}>
    {cover && <img src={cover} alt={project.title} loading="lazy" decoding="async" class="zoom-img h-full w-full object-cover" />}
    {project.category && <span class="pill absolute top-4 left-4 bg-paper/90 backdrop-blur">{project.category}</span>}
  </div>
  <div class="flex items-start justify-between gap-6 p-4 pt-5">
    <div>
      <h3 class="text-2xl font-semibold tracking-tight">{project.title}</h3>
      <p class="mt-2 max-w-xl text-[15px] leading-relaxed text-muted">{project.subtitle}</p>
      {project.tags && project.tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {project.tags.slice(0, 4).map((t) => <li class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{t}</li>)}
        </ul>
      )}
    </div>
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-soft transition-colors group-hover:bg-primary group-hover:text-white">↗</span>
  </div>
</a>
