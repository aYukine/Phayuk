---
interface Props { index?: string; eyebrow: string; title: string; href?: string; linkLabel?: string }
const { eyebrow, title, href, linkLabel = 'View all' } = Astro.props;
---

<div class="flex items-end justify-between gap-4">
  <div>
    <p class="pill">{eyebrow}</p>
    <h2 class="mt-4 text-[2rem] leading-tight sm:text-4xl font-semibold tracking-tight md:text-5xl">{title}</h2>
  </div>
  {href && (
    <a href={href} class="group shrink-0 text-sm font-semibold text-ink underline decoration-primary-strong decoration-2 underline-offset-4 sm:btn-secondary sm:no-underline">
      <span class="hidden sm:inline">{linkLabel}</span><span class="sm:hidden">View all</span> <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
    </a>
  )}
</div>
