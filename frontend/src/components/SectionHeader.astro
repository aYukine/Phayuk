---
interface Props { index?: string; eyebrow: string; title: string; href?: string; linkLabel?: string }
const { index, eyebrow, title, href, linkLabel = 'View all' } = Astro.props;
---

<div class="flex flex-col justify-between gap-6 border-b border-black pb-6 md:flex-row md:items-end">
  <div>
    <p class="eyebrow text-neutral-500">{index && <span class="mr-3 text-black">{index}</span>}{eyebrow}</p>
    <h2 class="mt-3 text-3xl font-black tracking-tight md:text-5xl">{title}</h2>
  </div>
  {href && <a href={href} class="group text-sm font-semibold">{linkLabel} <span class="inline-block transition-transform group-hover:translate-x-1">→</span></a>}
</div>
