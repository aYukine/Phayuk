---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <section class="px-3 pt-4 sm:px-4 pb-16">
    <div class="relative flex min-h-[65vh] items-center overflow-hidden rounded-[1.75rem] sm:rounded-[2.5rem] bg-soft">
      <div class="blob -top-20 -right-20 h-80 w-80 bg-highlight/70"></div>
      <div class="container-x relative text-center">
        <p class="pill bg-paper">Error 404</p>
        <h1 class="mt-6 text-6xl font-semibold tracking-tight md:text-8xl">Lost the <span class="mark">signal.</span></h1>
        <p class="mx-auto mt-6 max-w-lg text-lg text-muted">The page you're looking for doesn't exist or has moved.</p>
        <a href="/" class="btn-primary mt-10">Back home →</a>
      </div>
    </div>
  </section>
</Layout>
