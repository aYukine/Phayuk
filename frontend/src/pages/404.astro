---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" navDark>
  <section class="flex min-h-[80vh] items-center bg-black text-white">
    <div class="container-x pt-24">
      <p class="eyebrow text-neutral-500">Error 404</p>
      <h1 class="mt-4 text-6xl font-black tracking-tighter md:text-8xl">Lost the signal.</h1>
      <p class="mt-6 max-w-lg text-lg text-neutral-400">The page you're looking for doesn't exist or has moved.</p>
      <a href="/" class="btn-invert mt-10">Back home →</a>
    </div>
  </section>
</Layout>
