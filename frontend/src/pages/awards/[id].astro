---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import LinkButtons from '../../components/LinkButtons.astro';
import Embeds from '../../components/Embeds.astro';
import { awards, projects, paragraphs, type Award } from '../../lib/content';

export function getStaticPaths() {
  return awards.map((award) => ({ params: { id: award.id }, props: { award } }));
}
const { award } = Astro.props as { award: Award };
const project = projects.find((p) => p.id === award.project);
const jsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: award.title, description: award.summary, image: award.image ? new URL(award.image, Astro.site).href : undefined };
---

<Layout title={award.title} description={award.summary} image={award.image} type="article" jsonLd={jsonLd} navDark>
  <PageBanner back={{ href: '/awards/', label: 'All awards' }} eyebrow={`${award.year} · ${award.organization}`} title={award.title} lead={award.summary} image={award.image}>
    {award.placement && <p class="eyebrow mt-8 inline-block border border-white px-3 py-1.5">{award.placement}</p>}
  </PageBanner>

  <section class="container-x grid gap-12 py-20 md:grid-cols-12 md:py-24">
    <div class="md:col-span-7">
      {award.image && (
        <a href={award.image} target="_blank" class="block overflow-hidden bg-neutral-100">
          <img src={award.image} alt={award.title} class="w-full object-cover" />
        </a>
      )}
    </div>
    <div class="md:col-span-5">
      <p class="eyebrow text-neutral-500">The story</p>
      <div class="mt-4 space-y-5 text-lg leading-relaxed text-neutral-800">
        {paragraphs(award.description || award.summary).map((p) => <p>{p}</p>)}
      </div>
      {award.links && <div class="mt-8"><LinkButtons links={award.links} /></div>}
      {project && (
        <a href={`/projects/${project.id}/`} class="group mt-10 flex items-center justify-between border border-black p-6 transition-colors hover:bg-black hover:text-white">
          <div><p class="eyebrow opacity-60">Related project</p><p class="mt-1 text-xl font-bold">{project.title}</p></div>
          <span class="text-2xl">→</span>
        </a>
      )}
      <Embeds links={award.links} />
    </div>
  </section>
</Layout>
