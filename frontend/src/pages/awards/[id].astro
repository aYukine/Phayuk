---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import LinkButtons from '../../components/LinkButtons.astro';
import Embeds from '../../components/Embeds.astro';
import { awards, projects, paragraphs, type Award } from '../../lib/content';

export function getStaticPaths() {
  return awards.map((award) => ({ params: { id: award.id }, props: { award } }));
}
const { award } = Astro.props as { award: Award };
const project = projects.find((p) => p.id === award.project);
const jsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: award.title, description: award.summary, image: award.image ? new URL(award.image, Astro.site).href : undefined };
---

<Layout title={award.title} description={award.summary} image={award.image} type="article" jsonLd={jsonLd}>
  <PageBanner back={{ href: '/awards/', label: 'All awards' }} eyebrow={`${award.year} · ${award.organization}`} title={award.title} lead={award.summary}>
    {award.placement && <p class="mt-7"><span class="rounded-full bg-gold px-4 py-2 text-sm font-semibold">🏆 {award.placement}</span></p>}
  </PageBanner>

  <section class="container-x grid gap-8 py-12 md:grid-cols-12 md:gap-10 md:py-20">
    <div class="md:col-span-7">
      {award.image && (
        <a href={award.image} target="_blank" class="card block p-3">
          <img src={award.image} alt={award.title} class="w-full rounded-2xl object-cover" />
        </a>
      )}
    </div>
    <div class="md:col-span-5">
      <p class="pill">The story</p>
      <div class="mt-5 space-y-5 text-lg leading-relaxed">
        {paragraphs(award.description || award.summary).map((p) => <p>{p}</p>)}
      </div>
      {award.links && <div class="mt-8"><LinkButtons links={award.links} /></div>}
      {project && (
        <a href={`/projects/${project.id}/`} class="group mt-10 flex items-center justify-between gap-4 rounded-3xl bg-soft p-6 transition hover:bg-primary hover:text-white">
          <div><p class="text-xs font-medium opacity-60">Related project</p><p class="mt-1 font-serif text-xl font-semibold">{project.title}</p></div>
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-paper transition-transform group-hover:translate-x-1">→</span>
        </a>
      )}
      <Embeds links={award.links} />
    </div>
  </section>
</Layout>
