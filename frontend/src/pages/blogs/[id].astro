---
import Img from '../../components/Img.astro';
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import { blogs, paragraphs, type Blog } from '../../lib/content';

export function getStaticPaths() {
  return blogs.map((blog) => ({ params: { id: blog.id }, props: { blog } }));
}
const { blog } = Astro.props as { blog: Blog };
const images = blog.images || [];
const description = `${blog.title}: ${blog.context}. Travel log by Pholl Chanphayuk.`;
---

<Layout title={`${blog.title} — Journal`} description={description} image={blog.cover} type="article">
  <PageBanner back={{ href: '/blogs/', label: 'Journal' }} eyebrow={[blog.year, `${images.length} photos`].filter(Boolean).join(' · ')} title={blog.title} lead={blog.context} image={blog.cover} />

  {blog.body && (
    <section class="container-x py-16">
      <div class="max-w-3xl space-y-5 font-serif text-xl leading-relaxed">
        {paragraphs(blog.body).map((p) => <p>{p}</p>)}
      </div>
    </section>
  )}

  <section class="container-x py-16 md:py-20">
    <div class="columns-1 gap-4 sm:columns-2 sm:gap-6 lg:columns-3">
      {images.map((img, i) => (
        <figure class="mb-4 break-inside-avoid sm:mb-6">
          <button type="button" data-lightbox={img.src} data-caption={img.caption || ''} class="group block w-full cursor-zoom-in overflow-hidden rounded-2xl bg-soft shadow-soft">
            <Img src={img.src} alt={img.caption || `${blog.title}, photo ${i + 1}`} loading={i < 3 ? 'eager' : 'lazy'} class="zoom-img w-full" sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw" />
          </button>
          {img.caption && <figcaption class="mt-2 px-1 text-sm text-muted">{img.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </section>

  <dialog id="lightbox" class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-ink/90 backdrop:backdrop-blur-sm">
    <form method="dialog" class="flex h-[100dvh] w-[100vw] flex-col items-center justify-center gap-4 p-4">
      <img id="lightbox-img" src="" alt="" class="max-h-[85dvh] max-w-full rounded-2xl object-contain" />
      <p id="lightbox-cap" class="text-sm text-paper/80"></p>
      <button class="absolute top-6 right-6 rounded-full bg-white px-4 py-2 text-sm font-semibold text-ink" aria-label="Close">Close ✕</button>
    </form>
  </dialog>
</Layout>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const cap = document.getElementById('lightbox-cap') as HTMLElement;
  document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((el) =>
    el.addEventListener('click', () => {
      img.src = el.dataset.lightbox!;
      cap.textContent = el.dataset.caption || '';
      dlg.showModal();
    }),
  );
  dlg?.addEventListener('click', (e) => e.target === dlg.firstElementChild && dlg.close());
</script>
