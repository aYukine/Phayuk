---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import { blogs, paragraphs, type Blog } from '../../lib/content';

export function getStaticPaths() {
  return blogs.map((blog) => ({ params: { id: blog.id }, props: { blog } }));
}
const { blog } = Astro.props as { blog: Blog };
const images = blog.images || [];
const description = `${blog.title}: ${blog.context}. Travel log by Pholl Chanphayuk.`;
---

<Layout title={`${blog.title} — Journal`} description={description} image={blog.cover} type="article" navDark>
  <PageBanner back={{ href: '/blogs/', label: 'Journal' }} eyebrow={[blog.year, `${images.length} photos`].filter(Boolean).join(' · ')} title={blog.title} lead={blog.context} image={blog.cover} />

  {blog.body && (
    <section class="container-x py-16">
      <div class="max-w-3xl space-y-5 text-lg leading-relaxed text-neutral-800">
        {paragraphs(blog.body).map((p) => <p>{p}</p>)}
      </div>
    </section>
  )}

  <section class="container-x py-16 md:py-20">
    <div class="columns-1 gap-6 sm:columns-2 lg:columns-3">
      {images.map((img, i) => (
        <figure class="mb-6 break-inside-avoid">
          <button type="button" data-lightbox={img.src} data-caption={img.caption || ''} class="group block w-full cursor-zoom-in overflow-hidden bg-neutral-100">
            <img src={img.src} alt={img.caption || `${blog.title}, photo ${i + 1}`} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" class="w-full transition-transform duration-700 group-hover:scale-[1.02]" />
          </button>
          {img.caption && <figcaption class="mt-2 text-sm text-neutral-500">{img.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </section>

  <dialog id="lightbox" class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-black/95">
    <form method="dialog" class="flex h-[100dvh] w-[100vw] flex-col items-center justify-center gap-4 p-4">
      <img id="lightbox-img" src="" alt="" class="max-h-[85dvh] max-w-full object-contain" />
      <p id="lightbox-cap" class="text-sm text-neutral-400"></p>
      <button class="eyebrow absolute top-6 right-6 text-white" aria-label="Close">Close ✕</button>
    </form>
  </dialog>
</Layout>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const cap = document.getElementById('lightbox-cap') as HTMLElement;
  document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((el) =>
    el.addEventListener('click', () => {
      img.src = el.dataset.lightbox!;
      cap.textContent = el.dataset.caption || '';
      dlg.showModal();
    }),
  );
  dlg?.addEventListener('click', (e) => e.target === dlg.firstElementChild && dlg.close());
</script>
