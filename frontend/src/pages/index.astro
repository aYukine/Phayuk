---
import Img from '../components/Img.astro';
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, projects, awards, blogs, featured } from '../lib/content';

const topProjects = featured(projects, 3);
const topAwards = awards.slice(0, 4);
const topBlogs = blogs.slice(0, 3);
const statTints = ['bg-primary text-white', 'bg-white border border-line', 'bg-white border border-line'];
const skillTints = ['bg-soft', 'bg-leaf', 'bg-sunny', 'bg-lime', 'bg-cloud'];
---

<Layout>
  <!-- Banner -->
  <section class="relative overflow-hidden px-3 pt-4 sm:px-4">
    <div class="relative overflow-hidden rounded-[1.75rem] sm:rounded-[2.5rem] bg-soft">
      <div class="blob -top-32 -left-24 h-[28rem] w-[28rem] bg-highlight/70"></div>
      <div class="blob -top-24 -right-16 h-80 w-80 bg-gold/40"></div>
      <div class="blob -bottom-48 left-1/4 h-80 w-[40rem] bg-highlight/50"></div>

      <div class="container-x relative grid items-center gap-12 py-12 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-6">
          {site.eyebrow && (
            <p class="reveal pill bg-paper"><span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgb(16_185_129/0.7)]"></span>{site.eyebrow}{site.location && ` · ${site.location}`}</p>
          )}
          <h1 class="reveal mt-6 text-5xl leading-[0.98] font-semibold tracking-tight sm:text-6xl lg:text-7xl">
            Hi, I'm <span class="mark">{site.name.split(' ')[0]}</span><br />{site.name.split(' ').slice(1).join(' ')}
          </h1>
          <p class="reveal mt-6 text-xl font-medium md:text-2xl">{site.role}</p>
          {site.headline && <p class="reveal mt-2 text-lg text-muted md:text-xl">{site.headline}</p>}
          <div class="reveal mt-9 flex flex-wrap gap-3">
            <a href="/projects/" class="btn-primary">Explore projects <span aria-hidden="true">→</span></a>
            <a href="/awards/" class="btn-secondary">View achievements</a>
          </div>
        </div>

        <div class="relative lg:col-span-6">
          {site.banner && (
            <div class="reveal aspect-[4/3] overflow-hidden rounded-3xl border-4 border-paper shadow-lift sm:rotate-2 sm:rounded-[2rem] sm:border-8">
              <Img src={site.banner} alt={`${site.name} at a competition`} loading="eager" fetchpriority="high" class="h-full w-full object-cover" sizes="(min-width: 1024px) 560px, 100vw" />
            </div>
          )}
          {site.avatar && (
            <div class="float absolute -top-6 -left-2 flex sm:-left-4 items-center gap-3 rounded-2xl bg-paper p-2.5 pr-5 shadow-lift md:-left-10">
              <Img src={site.avatar} alt="" loading="eager" class="h-14 w-14 rounded-xl object-cover" sizes="56px" />
              <div>
                <p class="text-sm font-semibold">{site.name}</p>
                <p class="text-xs text-muted">Open to collaborate ✨</p>
              </div>
            </div>
          )}
          {site.stats && site.stats.length > 0 && (
            <dl class="mt-10 grid grid-cols-3 gap-2 sm:mt-16 sm:gap-3">
              {site.stats.map((s, i) => (
                <div class:list={['rounded-2xl px-2 py-4 text-center sm:p-4', statTints[i % statTints.length]]}>
                  <dd class="font-serif text-3xl font-semibold md:text-4xl">{s.value}</dd>
                  <dt class="mt-1 text-xs font-medium opacity-75">{s.label}</dt>
                </div>
              ))}
            </dl>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  {site.skills && site.skills.length > 0 && (
    <ul class="container-x mt-8 flex flex-wrap justify-center gap-2 sm:mt-10 sm:gap-2.5">
      {site.skills.map((s, i) => <li class:list={['rounded-full px-3.5 py-1.5 text-sm font-medium sm:px-4 sm:py-2', skillTints[i % skillTints.length]]}>{s}</li>)}
    </ul>
  )}

  <!-- About -->
  <section class="container-x grid items-center gap-10 py-16 md:grid-cols-12 md:gap-12 md:py-28">
    <div class="md:col-span-4">
      {site.avatar && (
        <div class="relative mx-auto max-w-[16rem] md:max-w-xs">
          <div class="absolute inset-0 -rotate-3 rounded-[2rem] bg-primary"></div>
          <Img src={site.avatar} alt={`Portrait of ${site.name}`} sizes="(min-width: 768px) 320px, 256px" class="relative aspect-square w-full rounded-[2rem] object-cover shadow-soft" />
        </div>
      )}
    </div>
    <div class="md:col-span-8">
      <p class="pill">About me</p>
      <p class="mt-5 font-serif text-[1.4rem] leading-snug sm:text-2xl md:text-[2.1rem] md:leading-tight">{site.bio}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        {site.resume && <a href={site.resume} target="_blank" rel="noopener" class="btn-primary">Download résumé ↓</a>}
        {site.email && <a href={`mailto:${site.email}`} class="btn-secondary">Contact me</a>}
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="container-x pb-16 md:pb-28">
    <SectionHeader eyebrow="Selected work" title="Featured projects" href="/projects/" linkLabel="All projects" />
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {topProjects.map((p, i) => (
        <div class:list={[i === 0 && 'md:col-span-2']}>
          <ProjectCard project={p} index={i} large={i === 0} />
        </div>
      ))}
    </div>
  </section>

  <!-- Awards -->
  <section class="px-4">
    <div class="rounded-[1.75rem] sm:rounded-[2.5rem] bg-soft py-14 md:py-24">
      <div class="container-x">
        <SectionHeader eyebrow="Recognition" title="Awards & milestones" href="/awards/" linkLabel="All awards" />
        <ol class="mt-10 grid gap-4">
          {topAwards.map((a) => (
            <li>
              <a href={`/awards/${a.id}/`} class="card card-hover group flex items-center gap-5 p-4 md:p-5">
                {a.image && <Img src={a.image} alt="" sizes="96px" class="hidden h-16 w-24 shrink-0 rounded-xl object-cover sm:block" />}
                <div class="min-w-0 flex-1">
                  <p class="text-xs font-medium text-muted">{a.year} · {a.organization}{a.placement && <span class="md:hidden"> · 🏆 {a.placement}</span>}</p>
                  <h3 class="mt-1 text-lg font-semibold tracking-tight md:text-xl">{a.title}</h3>
                </div>
                {a.placement && <span class="hidden shrink-0 rounded-full bg-gold px-3.5 py-1.5 text-xs font-semibold md:inline-block">🏆 {a.placement}</span>}
                <span class="shrink-0 text-xl text-muted transition-transform group-hover:translate-x-1">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Journal -->
  {topBlogs.length > 0 && (
    <section class="container-x py-16 md:py-28">
      <SectionHeader eyebrow="Journal" title="Travel & event logs" href="/blogs/" linkLabel="All entries" />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {topBlogs.map((b) => (
          <a href={`/blogs/${b.id}/`} class="card card-hover group block p-3">
            <div class="aspect-[4/3] overflow-hidden rounded-2xl bg-soft sm:aspect-[4/5]">
              {b.cover && <Img src={b.cover} alt={b.title} class="zoom-img h-full w-full object-cover" sizes="(min-width: 768px) 360px, 100vw" />}
            </div>
            <div class="p-3 pt-4">
              <p class="text-xs font-medium text-muted">{b.year || 'Log'} · {b.images?.length || 0} photos</p>
              <h3 class="mt-1 text-xl font-semibold tracking-tight">{b.title}</h3>
              <p class="mt-1 text-sm text-muted">{b.context}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>
