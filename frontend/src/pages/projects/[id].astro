---
import Img from '../../components/Img.astro';
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import LinkButtons from '../../components/LinkButtons.astro';
import Embeds from '../../components/Embeds.astro';
import { projects, awards, paragraphs, toEmbedUrl, isExternal, type Project } from '../../lib/content';

export function getStaticPaths() {
  return projects.map((project, i) => ({ params: { id: project.id }, props: { project, next: projects[(i + 1) % projects.length] } }));
}

const { project, next } = Astro.props as { project: Project; next: Project };
const cover = project.cover || project.steps?.[0]?.img;
const related = awards.filter((a) => a.project === project.id);
const meta = [
  project.category && { k: 'Category', v: project.category },
  project.year && { k: 'Year', v: project.year },
  related.length && { k: 'Recognition', v: `${related.length} award${related.length > 1 ? 's' : ''}` },
].filter(Boolean) as { k: string; v: string }[];
const tints = ['bg-soft', 'bg-leaf', 'bg-lime', 'bg-sunny', 'bg-cloud'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.subtitle,
  image: cover ? new URL(cover, Astro.site).href : undefined,
  keywords: project.tags?.join(', '),
  dateCreated: project.year,
};
---

<Layout title={project.title} description={project.subtitle} image={cover} type="article" jsonLd={jsonLd}>
  <PageBanner back={{ href: '/projects/', label: 'All projects' }} eyebrow={project.category} title={project.title} lead={project.subtitle} image={cover}>
    {project.links && project.links.length > 0 && <div class="mt-8"><LinkButtons links={project.links} /></div>}
  </PageBanner>

  <section class="container-x grid gap-8 py-12 md:grid-cols-12 md:gap-10 md:py-20">
    <aside class="md:col-span-4">
      <div class="card p-6">
        <dl class="divide-y divide-line">
          {meta.map((m) => (
            <div class="flex justify-between gap-4 py-3 text-sm first:pt-0"><dt class="text-muted">{m.k}</dt><dd class="text-right font-semibold">{m.v}</dd></div>
          ))}
        </dl>
        {project.tags && project.tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2">
            {project.tags.map((t, i) => <li class:list={['rounded-full px-3 py-1 text-xs font-medium', tints[i % tints.length]]}>{t}</li>)}
          </ul>
        )}
      </div>
    </aside>
    <div class="md:col-span-8">
      <p class="pill">Overview</p>
      <div class="mt-5 space-y-5 text-lg leading-relaxed sm:text-xl">
        {paragraphs(project.description || project.subtitle).map((p) => <p>{p}</p>)}
      </div>
      <Embeds links={project.links} />
    </div>
  </section>

  {project.steps && project.steps.length > 0 && (
    <section class="px-4">
      <div class="rounded-[1.75rem] sm:rounded-[2.5rem] bg-soft py-14 md:py-24">
        <div class="container-x">
          <div class="flex items-end justify-between">
            <div><p class="pill bg-paper">Build log</p><h2 class="mt-4 text-[2rem] leading-tight font-semibold tracking-tight md:text-5xl">How it came together</h2></div>
            <p class="hidden text-sm text-muted sm:block">{project.steps.length} stages</p>
          </div>
          <ol class="mt-8 grid gap-4 sm:mt-12 sm:gap-6">
            {project.steps.map((s, i) => (
              <li class="card grid items-center gap-4 p-3 sm:gap-6 sm:p-4 md:grid-cols-12 md:gap-10 md:p-5">
                <div class:list={['md:col-span-7', i % 2 === 1 && 'md:order-2']}>
                  {s.embed ? (
                    <div class="aspect-video overflow-hidden rounded-2xl bg-soft">
                      <iframe src={toEmbedUrl(s.embed)} title={s.label} loading="lazy" class="h-full w-full" allowfullscreen></iframe>
                    </div>
                  ) : s.img ? (
                    <a href={s.img} target="_blank" class:list={['group flex items-center justify-center overflow-hidden rounded-2xl', tints[i % tints.length]]}>
                      <Img src={s.img} alt={`${project.title}: ${s.label}`} class="zoom-img max-h-[480px] w-full object-contain" sizes="(min-width: 768px) 640px, 100vw" />
                    </a>
                  ) : null}
                </div>
                <div class="px-2 pb-3 md:col-span-5 md:p-2">
                  <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary font-serif text-white font-semibold">{i + 1}</span>
                  <h3 class="mt-4 text-2xl font-semibold tracking-tight">{s.label}</h3>
                  <p class="mt-3 leading-relaxed text-muted">{s.desc}</p>
                  {s.linkUrl && (
                    <a href={s.linkUrl} class="btn-secondary mt-6" {...(isExternal(s.linkUrl) ? { target: '_blank', rel: 'noopener' } : {})}>
                      {s.linkLabel || 'Learn more'} <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="container-x pt-20">
      <p class="pill">Recognition</p>
      <ul class="mt-6 grid gap-4 md:grid-cols-2">
        {related.map((a) => (
          <li>
            <a href={`/awards/${a.id}/`} class="card card-hover group flex items-center justify-between gap-6 p-6">
              <div><p class="text-xs font-medium text-muted">{a.year} · 🏆 {a.placement}</p><p class="mt-1 font-serif text-lg font-semibold">{a.title}</p></div>
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {next && next.id !== project.id && (
    <section class="container-x py-20">
      <a href={`/projects/${next.id}/`} class="group flex items-center justify-between gap-6 rounded-3xl bg-primary p-6 text-white sm:rounded-[2rem] sm:p-8 transition hover:bg-primary-strong md:p-12">
        <div><p class="text-sm font-medium text-white/70">Next project</p><p class="mt-2 font-serif text-2xl font-semibold tracking-tight sm:text-3xl md:text-5xl">{next.title}</p></div>
        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-white text-2xl text-primary transition-transform group-hover:translate-x-2">→</span>
      </a>
    </section>
  )}
</Layout>
