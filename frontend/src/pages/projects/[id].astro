---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import LinkButtons from '../../components/LinkButtons.astro';
import Embeds from '../../components/Embeds.astro';
import { projects, awards, paragraphs, toEmbedUrl, isExternal, type Project } from '../../lib/content';

export function getStaticPaths() {
  return projects.map((project, i) => ({ params: { id: project.id }, props: { project, next: projects[(i + 1) % projects.length] } }));
}

const { project, next } = Astro.props as { project: Project; next: Project };
const cover = project.cover || project.steps?.[0]?.img;
const related = awards.filter((a) => a.project === project.id);
const meta = [
  project.category && { k: 'Category', v: project.category },
  project.year && { k: 'Year', v: project.year },
  related.length && { k: 'Recognition', v: `${related.length} award${related.length > 1 ? 's' : ''}` },
].filter(Boolean) as { k: string; v: string }[];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.subtitle,
  image: cover ? new URL(cover, Astro.site).href : undefined,
  keywords: project.tags?.join(', '),
  dateCreated: project.year,
};
---

<Layout title={project.title} description={project.subtitle} image={cover} type="article" jsonLd={jsonLd} navDark>
  <PageBanner back={{ href: '/projects/', label: 'All projects' }} eyebrow={project.category} title={project.title} lead={project.subtitle} image={cover}>
    {project.links && project.links.length > 0 && <div class="mt-10"><LinkButtons links={project.links} dark /></div>}
  </PageBanner>

  <section class="container-x grid gap-12 py-20 md:grid-cols-12 md:py-24">
    <aside class="md:col-span-4">
      <dl class="divide-y divide-neutral-200 border-y border-neutral-200">
        {meta.map((m) => (
          <div class="flex justify-between gap-4 py-4 text-sm"><dt class="text-neutral-500">{m.k}</dt><dd class="text-right font-semibold">{m.v}</dd></div>
        ))}
      </dl>
      {project.tags && project.tags.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2">
          {project.tags.map((t) => <li class="border border-neutral-300 px-3 py-1 text-xs font-medium">{t}</li>)}
        </ul>
      )}
    </aside>
    <div class="md:col-span-8">
      <p class="eyebrow text-neutral-500">Overview</p>
      <div class="mt-4 space-y-5 text-xl leading-relaxed text-neutral-800">
        {paragraphs(project.description || project.subtitle).map((p) => <p>{p}</p>)}
      </div>
      <Embeds links={project.links} />
    </div>
  </section>

  {project.steps && project.steps.length > 0 && (
    <section class="border-t border-neutral-200 bg-neutral-50 py-20 md:py-28">
      <div class="container-x">
        <div class="flex items-end justify-between border-b border-black pb-6">
          <h2 class="text-3xl font-black tracking-tight md:text-4xl">Build log</h2>
          <p class="eyebrow text-neutral-500">{project.steps.length} stages</p>
        </div>
        <ol class="mt-4">
          {project.steps.map((s, i) => (
            <li class="grid items-center gap-8 border-b border-neutral-200 py-12 md:grid-cols-12 md:gap-12">
              <div class:list={['md:col-span-7', i % 2 === 1 && 'md:order-2']}>
                {s.embed ? (
                  <div class="aspect-video overflow-hidden bg-neutral-200">
                    <iframe src={toEmbedUrl(s.embed)} title={s.label} loading="lazy" class="h-full w-full" allowfullscreen></iframe>
                  </div>
                ) : s.img ? (
                  <a href={s.img} target="_blank" class="group block overflow-hidden bg-white">
                    <img src={s.img} alt={`${project.title}: ${s.label}`} loading="lazy" decoding="async" class="max-h-[520px] w-full object-contain transition-transform duration-700 group-hover:scale-[1.02]" />
                  </a>
                ) : null}
              </div>
              <div class="md:col-span-5">
                <p class="font-mono text-5xl font-black text-neutral-200">{String(i + 1).padStart(2, '0')}</p>
                <h3 class="mt-2 text-2xl font-bold tracking-tight">{s.label}</h3>
                <p class="mt-3 leading-relaxed text-neutral-600">{s.desc}</p>
                {s.linkUrl && (
                  <a href={s.linkUrl} class="btn-secondary mt-6" {...(isExternal(s.linkUrl) ? { target: '_blank', rel: 'noopener' } : {})}>
                    {s.linkLabel || 'Learn more'} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="container-x py-20">
      <p class="eyebrow text-neutral-500">Recognition</p>
      <ul class="mt-6 grid gap-4 md:grid-cols-2">
        {related.map((a) => (
          <li>
            <a href={`/awards/${a.id}/`} class="group flex items-center justify-between gap-6 border border-neutral-200 p-6 transition-colors hover:border-black">
              <div><p class="font-mono text-xs text-neutral-500">{a.year} · {a.placement}</p><p class="mt-1 font-bold">{a.title}</p></div>
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {next && next.id !== project.id && (
    <a href={`/projects/${next.id}/`} class="group block bg-black text-white">
      <div class="container-x flex items-center justify-between py-16">
        <div><p class="eyebrow text-neutral-500">Next project</p><p class="mt-2 text-3xl font-black tracking-tight md:text-5xl">{next.title}</p></div>
        <span class="text-4xl transition-transform group-hover:translate-x-2">→</span>
      </div>
    </a>
  )}
</Layout>
