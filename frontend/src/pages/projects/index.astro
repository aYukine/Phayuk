---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../lib/content';
const description = `Engineering and robotics projects by Pholl Chanphayuk: ${projects.map((p) => p.title).join(', ')}.`;
---

<Layout title="Projects" description={description}>
  <PageBanner eyebrow={`${projects.length} projects`} title="Things I've built" lead="Systems built end to end, from hardware prototypes and edge AI pipelines to production web platforms." image={projects[0]?.cover} />
  <section class="container-x py-14 md:py-24">
    <div class="grid gap-8 md:grid-cols-2">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </section>
</Layout>
